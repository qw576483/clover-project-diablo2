<Project>

  <!-- 构建产物只落 `.ai-tmp/test/`（⛔ 不在仓库树里留 bin/obj）。
       为什么必须放在本文件而不是 csproj 的 PropertyGroup 里：
       SDK 风格工程会**先**导入 `Microsoft.Common.props`，那时 `BaseIntermediateOutputPath`
       已被 MSBuild 用过 ⇒ 之后再改会报 `MSB3539`（实测：那行 warning 会混进
       `s1_boundary.tsv` 的输出里）。`Directory.Build.props` 在它之前导入，故放这里。
       （本 csproj 在 `tools/probes/enumerate/s1check/` ⇒ 上溯 3 层 = 仓根。） -->

  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\.ai-tmp\test\s1check-obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\..\.ai-tmp\test\s1check-bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
