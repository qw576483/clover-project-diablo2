<!-- ─────────────────────────────────────────────────────────────────────────────
     tools/probes/drivers/d2u32_compilecheck/Directory.Build.props
     本哨兵**自带一份**（内容照 `../d2u27_compilecheck/Directory.Build.props`）：
     MSBuild 只取"向上找到的**第一个** Directory.Build.props"，而本目录在 `drivers/` 下
     ⇒ 不带这份就取不到（`$(UnityEditorVersion)` / `$(UnityEditorRoot)` 无默认值）。

     它管两件事：
       ① 解析「Unity 编辑器 → 托管 DLL」的位置（换机器 / 换盘 / 换小版本都不必改 csproj）。
          覆盖优先级：1) 环境变量 UNITY_EDITOR_ROOT
                     2) 命令行 -p:UnityEditorVersion=<版本> / -p:UnityHubRoot=<Hub\Editor 目录>
                     3) 默认 $(ProgramFiles)\Unity\Hub\Editor\6000.6.0f1\Editor
       ② 构建产物**必须落在仓树之外**（判据资产要提交，构建产物不许提交）：
          obj/bin 一律重定向到 `<项目根>/.ai-tmp/test/d2u32-build/`（`.ai-tmp` 不入仓）。
          ⚠️ 必须在 props 里设：SDK 在导入 props **之前**就用到这两个属性，
             写在 csproj 里对 restore 产物已经太晚（`d2u27_compilecheck` 实测过）。
     ───────────────────────────────────────────────────────────────────────────── -->
<Project>

  <PropertyGroup>
    <UnityEditorVersion Condition="'$(UnityEditorVersion)' == ''">6000.6.0f1</UnityEditorVersion>

    <UnityHubRoot Condition="'$(UnityHubRoot)' == '' and '$(UNITY_HUB_ROOT)' != ''">$(UNITY_HUB_ROOT)</UnityHubRoot>
    <UnityHubRoot Condition="'$(UnityHubRoot)' == ''">$(ProgramFiles)\Unity\Hub\Editor</UnityHubRoot>

    <UnityEditorRoot Condition="'$(UnityEditorRoot)' == '' and '$(UNITY_EDITOR_ROOT)' != ''">$(UNITY_EDITOR_ROOT)</UnityEditorRoot>
    <UnityEditorRoot Condition="'$(UnityEditorRoot)' == ''">$(UnityHubRoot)\$(UnityEditorVersion)\Editor</UnityEditorRoot>

    <UnityManagedDir>$(UnityEditorRoot)\Data\Managed</UnityManagedDir>
  </PropertyGroup>

  <!-- 路径不对时给一句人话，而不是让 MSBuild 报一堆 "could not be resolved" -->
  <Target Name="CloverCheckUnityEditorRoot" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(UnityManagedDir)\UnityEngine\UnityEngine.CoreModule.dll')">
    <Error Text="找不到 Unity 托管 DLL：$(UnityManagedDir)\UnityEngine\UnityEngine.CoreModule.dll。请设环境变量 UNITY_EDITOR_ROOT 指向你的 Unity 编辑器目录（例 [盘符]:\Unity\Hub\Editor\[版本]\Editor），或加 -p:UnityEditorVersion=[版本]。" />
  </Target>

  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../../.ai-tmp/test/d2u32-build/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../../.ai-tmp/test/d2u32-build/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
