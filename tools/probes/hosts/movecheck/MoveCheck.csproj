<Project Sdk="Microsoft.NET.Sdk">

  <!--
       片 2b「移动手感」数值自证宿主（一次性，随 .ai-tmp 清理）

       目的：把片 2b 改的每一个数都变成**可离线断言**的项（秒级、不依赖 Unity）：
         · 速度 / 视野 / 怪物速度量纲的常量值；
         · 新增的 FpsForCycle / SpeedScaleForCycle 口径；
         · SpriteFrameCounts 的 run 列与 ViewAnim.Run 下标一致；
         · **玩家走/跑时移动动画的有效帧率 = 帧数 x 速度**（用真 SpriteAnimator 逐帧推进实测）。

       做法与 .ai-tmp/hosts 下其它宿主一致（链**真实业务源码** + 引擎门面替身，不复制逻辑）：
       shim 直接复用 fullcheck 那一份（内容取自 combatcheck 的超集，含 WorldHpBar）。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MoveCheck</AssemblyName>
    <RootNamespace>MoveCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169;CS0414;CS0067;CS0436</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主自身 -->
    <Compile Include="Program.cs" />
    <!-- 引擎门面替身（复用 fullcheck 那份；**不是**引擎本体） -->
    <Compile Include="..\fullcheck\shim\EngineShim.cs" />

    <!-- Diablo2 业务代码：全量（与 Assets/Scripts 同一份文件，不复制、不排除） -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\App\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Core\*.cs" />
