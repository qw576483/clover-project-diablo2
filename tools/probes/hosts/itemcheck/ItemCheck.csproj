<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       Item / Quest / Npc / Save 自检宿主（**非 Unity 工程、不参与打包**）

       为什么需要它：`client/client.slnx` 里没有 `Diablo2.csproj`
       （用户尚未打开编辑器 ⇒ Unity 未重新生成工程文件 ⇒ `dotnet build client.slnx`
        **覆盖不到** `Assets/Scripts/**`）。本工程把「引擎托管 DLL + Diablo2 源码」直接编到 .NET 上，
       得到**秒级**的类型校验 + **可运行**的断言（做法照 `tools/mapcheck/`(agent-04)、
       `tools/flowcheck/`(agent-05)，见 skill `reference/fast-compile-loop.md`）。

       覆盖：掉落/品质/词缀、背包格子、拾取（距离+满包）、腰带喝药、装备生效（EquipChanged 载荷）、
             任务链「邪恶洞穴」全流程 + 只认洞穴、NPC 对话随阶段、商店买卖/修理、存档往返。
       不覆盖（需要 Unity 原生）：面板像素布局、真人手感、Unity 原生 JsonUtility（本项目存档走自研
             `SaveJson`，见 `Module/Save/SaveJson.cs` 的文件头原因说明）。
       ─────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ItemCheck</AssemblyName>
    <RootNamespace>ItemCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169;CS0414;CS0067</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 自检宿主自身 -->
    <Compile Include="Program.cs" />
    <!-- 引擎门面替身（只提供 Diablo2 源码用到的成员；**不是**引擎本体） -->
    <Compile Include="shim\EngineShim.cs" />

    <!-- Diablo2 源码（与 Assets/Scripts 同一份文件，不复制） -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Def\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Core\*.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\Rng.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\LogThrottle.cs" />
    <!-- ★ agent-33 引擎下沉 A2：`Core/AStar.cs` 已删、`Core/Iso.cs` 变成薄门面 ⇒
         寻路（AStar）与等距几何/排序/方向（IsoLayout + 引擎版 Dir8）改从**引擎源码**编进来 -->
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\AStar.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\IsoLayout.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\Dir8.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Contracts.cs" />
    <!-- ★ agent-35 引擎下沉 A4：配表加载器已下沉到引擎（`Table/TableLoader.cs` 变薄转发）⇒
         引擎侧那一份源码也必须链进来，否则 `CloverEngine.CloverTable` 找不到（CS0246）。
         依赖：`CloverTable.cs` 只用到 `System.IO/Reflection` + `LogThrottle`（上面已链）。 -->
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Data\CloverTable.cs" />
    <!-- ⚠️ 本行**与起始装备改动无关**（起始装备轮实测发现，已写进回报）：`Core/FramePacing.cs` 已改成
         转发 `CloverEngine.FramePacingPolicy`，而引擎侧那一份（`Runtime/Presentation/FramePacing.cs`）
         **没有被任何宿主链进来** ⇒ 本宿主与 savecheck / playercheck … **全部离线宿主**都编不过
         （`error CS0234: 命名空间"CloverEngine"中不存在类型或命名空间名"FramePacing"`，2026-09-22 复现）。
         本行的作用 = 只把本宿主救回来（本文件在本片白名单内）；其它宿主同样缺这一行，由主 agent 统一处理。 -->
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Presentation\FramePacing.cs" />
    <!-- ★ agent-38 补（`# direct-fix:`）：agent-37 引擎下沉 A6 把项目存档改成走引擎的
         `CloverEngine.FileSlotStore`（`Module/Save/SaveModule.cs:64`），但本宿主的链接清单没跟着加
         ⇒ `CS0246: 未能找到类型或命名空间名"FileSlotStore"`（verify.ps1 的 offline-hosts 因此 FAIL）。
         口径与 `savecheck/SaveCheck.csproj:49,56` 一致：`FileSlotStore` 的 `.json` 坏档判定走引擎
         `MiniJson`（`Runtime/Core/Json.cs`）⇒ 这两份必须一起链进来。 -->
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Data\FileSlotStore.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\Json.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Table\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Table\Base\*.cs" />
    <!--
      真实的 `App/AppContext.cs`（**要验 `AutoWire` 真的能反射装出四个模块**），
      它只依赖流程门面 `IAppFlow` ⇒ 只编那一个文件。
      ⚠️ 故意**不**纳入 `Module/Flow/**`、`UI/**`、`App/Bootstrap.cs`：
         Flow/UI 由 agent-05 / agent-09 并行编写，随时处于"改到一半"的中间态；
         纳入进来会把别人的半成品算成本模块的编译失败（本宿主只负责本模块的验证）。
    -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Flow\IAppFlow.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\App\AppContext.cs" />
    <!-- ★ 本轮（T0 判据缺口 1「死亡不掉金币」）新增：把 `Module/Player` + `Module/Input` 编进来，
         让本宿主能用**真实** `PlayerModule`（而不是本文件的 `StubPlayer`）断言「死亡扣当前金币 10%」——
         这条断言必须打在**生产实现**上，打在桩上等于没测（桩的 `Kill()` 只把生命置 0）。
         依赖：`Module/Player/**`（PlayerStats/PlayerMotor/PlayerLog）+ `Module/Input/**`
         （`InputReader`/`HoverPicker`，命名空间是 `Diablo2.Module`）+ `AppContext` + `Iso`/`Table`。
         ⛔ 不改任何业务代码，只把源文件链进本宿主。 -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Player\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Input\*.cs" />
    <!-- ★ 片 G1 补（# direct-fix:）：宿主原先编不过的**既有**缺口 ——
         `Module/Player/PlayerModule.cs:160` 现在引用 `Diablo2.Module.Map`（M3 的接缝/桥面改动之后），
         而本宿主的链接清单里没有 `Module/Map/**` ⇒ `CS0234: 命名空间"Diablo2.Module"中不存在"Map"`。
         ⇒ 把 `Module/Map/**` 链进来（本片没改这些文件，只是让宿主恢复可编译）。
         本宿主已有 `StubMap : IMapModule`（不重名，无冲突）。 -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Map\*.cs" />
    <!-- ★ eng-tile 片（2026-09-24）：`Module/Map/TileNodePool.cs` + `TileRenderState.cs` 已下沉到引擎
         （项目侧只剩薄转发）⇒ 不链引擎那两份就 CS0246（`Module/Map/MapView.cs` 用它们）。 -->
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Presentation\TileNodePool.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Presentation\TileRenderState.cs" />

    <!-- ★ 起始装备轮新增：只链 `DamageFormula.cs` + `CombatLog.cs` 两个文件（**不是**整个 Module/Combat/**），
         为的是用**生产入口**断言「起始装备让普攻伤害真的 > 0」（配表 → ItemStack.dmg → 官方物理伤害公式）。
         ⚠️ 不链 `Module/Combat/*.cs` 全量：那会把 CombatModule/Monster/Skill/View 一起拉进来，
            与本宿主已有的桩（StubMonster/StubSkill）冲突。
         依赖检查：`DamageFormula` 只用到 `CloverEngine` / `Diablo2.Core` / `Diablo2.Def` / `UnityEngine` / `Table`
            与 `CombatLog`；`CombatLog` 只用到 `Diablo2.Core.Log`（**不读时钟**，故离线宿主可安全调用）。 -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Combat\DamageFormula.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Combat\CombatLog.cs" />
    <!-- ★ 片 O（R6）新增：只链 `DeathFlow.cs`（不是整个 Module/Combat/**，那会与 StubMonster/StubSkill 冲突），
         为的是用**生产入口**断言「精英怪的 TC 槽位判定」`DeathFlow.EliteKindOf`（词缀 kind → TreasureClass2/3）。
         依赖检查：DeathFlow 只用 `CloverEngine` / `Diablo2.Core`(Events/Rng/Log) / `Diablo2.Def` / `Table` /
             `UnityEngine` + 本宿主已链的 `CombatLog` + 门面 `AppContext`(已链) 与 `Contracts.cs`(已链)。 -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Combat\DeathFlow.cs" />

    <!-- 本 agent 的四个模块 -->
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Item\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Quest\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Npc\*.cs" />
    <Compile Include="..\..\..\..\client\Assets\Scripts\Module\Save\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEditorRoot)\Data\Managed\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityEditorRoot)\Data\Managed\UnityEngine\UnityEngine.UIModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityEditorRoot)\Data\Managed\UnityEngine\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- `Core/ClientConfig.cs`（agent-01）用 `JsonUtility.FromJson` 读 config.json ⇒ 需要本模块 DLL。
         ⚠️ 本宿主**不调用** `Cfg`（它是 Unity 原生调用）；本项目的存档一律走自研 `SaveJson`。 -->
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(UnityEditorRoot)\Data\Managed\UnityEngine\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityEditorRoot)\Data\Managed\UnityEngine\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\..\..\client\Library\ScriptAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>


  <!-- eng-coreutil: sunk caps (project file forwards to engine) -->
  <ItemGroup>
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\GridBitSet.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\ClientConfig.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\EnterLatch.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\GridGraph.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Presentation\TileRenderer.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\ServiceAutoWire.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Presentation\ChunkedTilePlanner.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\StableHash.cs" />
    <Compile Include="..\..\..\..\..\clover-client-unity-engine\Runtime\Core\JsonWriter.cs" />
  </ItemGroup>
</Project>
